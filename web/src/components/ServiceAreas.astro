---
import Icon from './Icon.astro';
---
<section class="areas-contact" aria-label="Service areas and contact"><div class="areas-grid container">
  <div id="areas" class="areas-copy"><p class="eyebrow">Service areas</p><h2>Proudly Serving<br />South Florida</h2><p>Miami, Hialeah, Fort Lauderdale, West Palm Beach and surrounding areas.</p><a class="button button-light-outline" href="#area-cities">View Service Areas <Icon name="arrow" /></a></div>
  <div class="area-map-block"><svg class="florida-map" viewBox="0 0 240 310" role="img" aria-labelledby="map-title map-description"><title id="map-title">South Florida service area illustration</title><desc id="map-description">Stylized Florida peninsula highlighting the southeast coast. Schematic illustration, not a map to scale.</desc><path class="map-shape" d="M20 16 105 17 112 27 128 25 147 33 148 61 156 84 173 113 185 145 201 175 214 207 214 233 205 255 191 274 184 287 173 279 162 258 153 232 148 209 139 181 123 153 111 126 101 109 91 98 88 74 66 64 42 54 29 38 17 35Z"/><path class="map-coast" d="m185 145 16 30 13 32v26l-9 22-14 19"/><g class="map-dots"><circle cx="201" cy="178" r="5"/><circle cx="211" cy="213" r="5"/><circle cx="201" cy="246" r="5"/><circle cx="207" cy="254" r="5"/></g><path class="map-keys" d="m189 293-5 4m-7 0-5 3m-7-1-5 3"/></svg><ul id="area-cities" class="city-list"><li><Icon name="pin" />West Palm Beach</li><li><Icon name="pin" />Fort Lauderdale</li><li><Icon name="pin" />Hialeah</li><li><Icon name="pin" />Miami</li></ul></div>
  <div class="contact-copy"><p class="eyebrow">Get in touch</p><h2>Let's Build Together</h2><p>Have a project in mind? Your next chapter starts with a conversation.</p><a class="button button-gold" href="#contact">Get a Free Estimate <Icon name="arrow" /></a><p class="contact-status">Tell us about your project in the estimate section below.</p></div>
</div></section>
