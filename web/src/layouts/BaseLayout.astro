---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Zira Group Inc | Construction & Remodeling in South Florida',
  description = 'Residential and commercial construction, remodeling, and home improvement services throughout South Florida. Quality Construction for a Better Tomorrow.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102B46" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zira Group Inc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
