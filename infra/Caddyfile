{
    admin off
    auto_https off
}

:80 {
    @www host www.ziragroupinc.com
    redir @www https://ziragroupinc.com{uri} permanent
    root * /srv
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server
}
